<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="camera">

  <!-- Camera link: frame at the box's geometric center -->
  <link name="camera">
    <inertial>
      <mass value="${camera_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="${camera_mass * (camera_size_y**2 + camera_size_z**2) / 12}"
          ixy="0"
          ixz="0"
          iyy="${camera_mass * (camera_size_x**2 + camera_size_z**2) / 12}"
          iyz="0"
          izz="${camera_mass * (camera_size_x**2 + camera_size_y**2) / 12}"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/>
      </geometry>
      <material name="red" />
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/>
      </geometry>
    </collision>
  </link>

  <!--
    Camera joint: mount flush against chassis front face.
      x-offset = chassis_length/2 + camera_size_x/2
      z-offset = 0 (vertically centered on chassis)
  -->
  <joint name="chassis_to_camera_joint" type="fixed">
    <origin xyz="${chassis_length/2 + camera_size_x/2} 0 0" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="camera"/>
  </joint>

  <!-- Camera optical frame: ROS convention (Z forward, X right, Y down) -->
  <link name="camera_optical_frame"/>

  <joint name="camera_to_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="camera"/>
    <child link="camera_optical_frame"/>
  </joint>

  <!-- Gazebo RGB camera sensor -->
  <gazebo reference="camera">
    <sensor name="rgb_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <topic>/camera/rgb/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>100.0</far>
        </clip>
      </camera>
    </sensor>

    <material>Gazebo/Red</material>
  </gazebo>

</robot>
